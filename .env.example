DEBUG=False
SECRET_KEY=generate-a-strong-random-key-in-production
ALLOWED_HOSTS=*

# Supabase Database Configuration (PostgreSQL)
# Option A: Paste your Supabase URI connection string (Recommended - Session pooler 5432 or Transaction pooler 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Individual Supabase connection parameters:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_HOST=aws-0-[REGION].pooler.supabase.com
# DB_PORT=5432

# Google Gemini API Key (Required for AI resume parsing, candidate scoring, and requisition drafting)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://capstone-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app

# API Client Security Key (must match NEXT_PUBLIC_APP_CLIENT_KEY on frontend)
APP_CLIENT_KEY=talentmatch-client-key-2026

# Cloudflare R2 Storage (S3-compatible bucket for resume uploads)
USE_R2_STORAGE=True
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=capstone-talentmatch
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_REGION_NAME=auto
